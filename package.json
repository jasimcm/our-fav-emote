{
  "name": "oru-companion",
  "version": "0.1.0",
  "description": "A hyperrealistic desktop companion that walks above your taskbar and reminds you to drink water.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "npm run build && electron .",
    "placeholders": "electron scripts/make-placeholders.cjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist:mac": "npm run build && npm run build:segment && electron-builder --mac --publish never",
    "build:segment": "mkdir -p tools/bin && swiftc -O tools/segment.swift -o tools/bin/segment",
    "test-media": "node scripts/make-test-media.mjs .smoke-media"
  },
  "author": "Jasim",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "productName": "Oru Companion",
  "build": {
    "appId": "org.tinkerhub.oru-companion",
    "productName": "Oru Companion",
    "files": [
      "dist/**",
      "!dist/cli/**",
      "characters/**",
      "!characters/**/import.sh",
      "!characters/**/sources.json",
      "assets/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Oru-Companion-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.lifestyle",
      "extendInfo": {
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "tools/bin/segment",
          "to": "bin/segment"
        }
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/**"
      ]
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "portable": {
      "artifactName": "Oru-Companion-${version}-portable.${ext}"
    },
    "dmg": {
      "artifactName": "Oru-Companion-${version}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.30.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasimcm/our-fav-emote.git"
  },
  "homepage": "https://github.com/jasimcm/our-fav-emote"
}
