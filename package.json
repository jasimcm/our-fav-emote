{
  "name": "oru-companion",
  "version": "0.1.0",
  "description": "A hyperrealistic desktop companion that walks above your taskbar and reminds you to drink water.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "npm run build && electron .",
    "placeholders": "electron scripts/make-placeholders.cjs",
    "dist:win": "npm run build && electron-builder --win",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dist:mac": "npm run build && npm run build:segment && electron-builder --mac",
    "build:segment": "swiftc -O tools/segment.swift -o tools/bin/segment"
  },
  "author": "Jasim",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "productName": "Oru Companion",
  "build": {
    "appId": "org.tinkerhub.oru-companion",
    "productName": "Oru Companion",
    "files": [
      "dist/**",
      "!dist/cli/**",
      "characters/**",
      "!characters/**/import.sh",
      "!characters/**/sources.json",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.lifestyle",
      "extendInfo": {
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "tools/bin/segment",
          "to": "bin/segment"
        }
      ]
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jasimcm/oru-companion.git"
  },
  "homepage": "https://github.com/jasimcm/oru-companion"
}
